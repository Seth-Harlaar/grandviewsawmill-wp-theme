{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "bark", "color": "#3d2b1f", "name": "Bark" },
				{ "slug": "cream", "color": "#faf6f0", "name": "Cream" },
				{ "slug": "ink", "color": "#2b2118", "name": "Ink" },
				{ "slug": "rust", "color": "#8a4b1c", "name": "Rust" }
			]
		},
		"layout": {
			"contentSize": "800px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "system-ui, sans-serif",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--rust)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
